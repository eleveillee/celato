# ========================
# Celato Environment Variables
# ========================

# ============================================================================
# API Server Configuration
# ============================================================================

# Port for the API orchestrator (changed to 4000 to avoid conflicts)
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Node environment: development | production | test
NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ============================================================================
# Mobile App Configuration
# ============================================================================

# WebSocket URL for connecting to the API orchestrator
# Development (iOS Simulator):     ws://localhost:4000/ws
# Development (Android Emulator):  ws://10.0.2.2:4000/ws
# Development (Physical Device):   ws://YOUR_COMPUTER_IP:4000/ws
#   Find your IP: Windows = ipconfig, Mac/Linux = ifconfig | grep inet
# Production:                      wss://api.celato.com/ws
WS_URL=ws://localhost:4000/ws

# ============================================================================
# Third-Party Services (VS-1 and beyond)
# ============================================================================

# OpenAI Realtime API (VS-1)
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...

# Retell AI (VS-1)
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...

# Supabase (VS-2)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================================
# Feature Flags (VS-3 and beyond)
# ============================================================================

ENABLE_SMART_COST_TIERING=false
ENABLE_CALL_RECORDING=false
