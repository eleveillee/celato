# ========================
# Celato Environment Variables
# ========================

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...

# Retell AI
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App Configuration
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Feature Flags
ENABLE_SMART_COST_TIERING=false
ENABLE_CALL_RECORDING=false

# Logging
LOG_LEVEL=info
