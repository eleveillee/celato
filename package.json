{
  "name": "celato",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative voice agent for phone calls - the Bionic Director",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:mobile": "pnpm --filter @celato/mobile dev",
    "dev:api": "pnpm --filter @celato/api dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {}
  }
}
