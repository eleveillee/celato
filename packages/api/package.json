{
  "name": "@celato/api",
  "version": "0.1.0",
  "private": true,
  "description": "Celato API Orchestrator - audio routing and session management",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=../../.env dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@celato/shared": "workspace:*",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "openai": "^4.76.0",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
