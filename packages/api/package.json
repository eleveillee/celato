{
  "name": "@celato/api",
  "version": "0.1.0",
  "private": true,
  "description": "Celato API Orchestrator - audio routing and session management",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=../../.env dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@celato/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.7.4",
    "openai": "^6.22.0",
    "pino": "^10.3.1",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
